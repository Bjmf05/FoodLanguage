// ========================================
// Ejemplos de Matrices en FoodLanguage
// ========================================

// Ejemplo 1: Matriz básica 3x3
recipe matrizBasica() {
    taste("=== Ejemplo 1: Matriz Básica ===")
    
    menu matriz == [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
    taste("Matriz completa: ", matriz)
    
    quantity elemento == matriz[1][1]
    taste("Elemento central [1][1]: ", elemento)
    
    matriz[0][0] == 100
    taste("Primera posición modificada: ", matriz[0][0])
    
    serve matriz
}

// Ejemplo 2: Suma de matrices 2x2
recipe sumaMatrices() {
    taste("=== Ejemplo 2: Suma de Matrices ===")
    
    menu matA == [[1, 2], [3, 4]]
    menu matB == [[5, 6], [7, 8]]
    menu resultado == [[0, 0], [0, 0]]
    
    // Sumar elemento por elemento
    stir (quantity i == 0, i < 2, i++) {
        stir (quantity j == 0, j < 2, j++) {
            resultado[i][j] == matA[i][j] ++ matB[i][j]
        }
    }
    
    taste("Matriz A: ", matA)
    taste("Matriz B: ", matB)
    taste("Resultado A + B: ", resultado)
    
    serve resultado
}

// Ejemplo 3: Diagonal de una matriz
recipe sumaDiagonal() {
    taste("=== Ejemplo 3: Suma Diagonal ===")
    
    menu matriz == [[10, 20, 30], [40, 50, 60], [70, 80, 90]]
    quantity suma == 0
    
    // Sumar elementos de la diagonal principal
    stir (quantity i == 0, i < 3, i++) {
        suma == suma ++ matriz[i][i]
        taste("Diagonal [", i, "][", i, "]: ", matriz[i][i])
    }
    
    taste("Suma de la diagonal: ", suma)
    serve suma
}

// Ejemplo 4: Matriz identidad
recipe matrizIdentidad() {
    taste("=== Ejemplo 4: Matriz Identidad ===")
    
    menu identidad == [[0, 0, 0], [0, 0, 0], [0, 0, 0]]
    
    // Crear matriz identidad 3x3
    stir (quantity i == 0, i < 3, i++) {
        identidad[i][i] == 1
    }
    
    taste("Matriz Identidad 3x3:")
    stir (quantity i == 0, i < 3, i++) {
        taste("  ", identidad[i])
    }
    
    serve identidad
}

// Ejemplo 5: Multiplicación de matriz por escalar
recipe multiplicarPorEscalar() {
    taste("=== Ejemplo 5: Multiplicar por Escalar ===")
    
    menu matriz == [[1, 2], [3, 4]]
    quantity escalar == 3
    menu resultado == [[0, 0], [0, 0]]
    
    stir (quantity i == 0, i < 2, i++) {
        stir (quantity j == 0, j < 2, j++) {
            resultado[i][j] == matriz[i][j] ** escalar
        }
    }
    
    taste("Matriz original: ", matriz)
    taste("Escalar: ", escalar)
    taste("Resultado: ", resultado)
    
    serve resultado
}

// Ejemplo 6: Transponer matriz
recipe transponerMatriz() {
    taste("=== Ejemplo 6: Transponer Matriz ===")
    
    menu original == [[1, 2, 3], [4, 5, 6]]
    menu transpuesta == [[0, 0], [0, 0], [0, 0]]
    
    // Original es 2x3, transpuesta será 3x2
    stir (quantity i == 0, i < 2, i++) {
        stir (quantity j == 0, j < 3, j++) {
            transpuesta[j][i] == original[i][j]
        }
    }
    
    taste("Matriz original 2x3:")
    stir (quantity i == 0, i < 2, i++) {
        taste("  ", original[i])
    }
    
    taste("Matriz transpuesta 3x2:")
    stir (quantity i == 0, i < 3, i++) {
        taste("  ", transpuesta[i])
    }
    
    serve transpuesta
}

// Ejemplo 7: Buscar valor máximo en matriz
recipe valorMaximo() {
    taste("=== Ejemplo 7: Valor Máximo ===")
    
    menu matriz == [[5, 12, 8], [15, 3, 20], [7, 18, 9]]
    quantity max == matriz[0][0]
    quantity maxFila == 0
    quantity maxColumna == 0
    
    stir (quantity i == 0, i < 3, i++) {
        stir (quantity j == 0, j < 3, j++) {
            if_has (matriz[i][j] > max) {
                max == matriz[i][j]
                maxFila == i
                maxColumna == j
            }
        }
    }
    
    taste("Matriz: ", matriz)
    taste("Valor máximo: ", max)
    taste("Posición: [", maxFila, "][", maxColumna, "]")
    
    serve max
}

// Ejemplo 8: Tablero de Tres en Raya (Tic-Tac-Toe)
recipe tableroTresEnRaya() {
    taste("=== Ejemplo 8: Tablero Tres en Raya ===")
    
    menu tablero == [["-", "-", "-"], ["-", "-", "-"], ["-", "-", "-"]]
    
    // Simular algunas jugadas
    tablero[0][0] == "X"
    tablero[0][1] == "O"
    tablero[1][1] == "X"
    tablero[2][2] == "O"
    tablero[1][0] == "X"
    
    taste("Estado del tablero:")
    stir (quantity i == 0, i < 3, i++) {
        taste("  ", tablero[i][0], " | ", tablero[i][1], " | ", tablero[i][2])
        if_has (i < 2) {
            taste("  ---------")
        }
    }
    
    serve tablero
}

// Ejemplo 9: Matriz con variables
recipe matrizConVariables() {
    taste("=== Ejemplo 9: Matriz con Variables ===")
    
    quantity a == 10
    quantity b == 20
    quantity c == 30
    
    menu matriz == [[a, b], [c, a ++ b]]
    
    taste("Variables: a=", a, ", b=", b, ", c=", c)
    taste("Matriz resultante: ", matriz)
    taste("Elemento [1][1] (a+b): ", matriz[1][1])
    
    serve matriz
}

// Ejemplo 10: Suma de filas y columnas
recipe sumaFilasColumnas() {
    taste("=== Ejemplo 10: Suma de Filas y Columnas ===")
    
    menu matriz == [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
    
    // Sumar cada fila
    taste("Suma de filas:")
    stir (quantity i == 0, i < 3, i++) {
        quantity sumaFila == 0
        stir (quantity j == 0, j < 3, j++) {
            sumaFila == sumaFila ++ matriz[i][j]
        }
        taste("  Fila ", i, ": ", sumaFila)
    }
    
    // Sumar cada columna
    taste("Suma de columnas:")
    stir (quantity j == 0, j < 3, j++) {
        quantity sumaCol == 0
        stir (quantity i == 0, i < 3, i++) {
            sumaCol == sumaCol ++ matriz[i][j]
        }
        taste("  Columna ", j, ": ", sumaCol)
    }
    
    serve matriz
}
